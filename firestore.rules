rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Firestore rejects a `list` request unless the query's own filters make
    // every possible matched document provably satisfy the rule — it does not
    // execute the query and filter afterward. Both index.html and admin.html's
    // dashboard query with `.where("date", "==", <today's date string>)`, so
    // the anonymous branch below must key off `date` (matching that filter),
    // not `createdAt` (which no query here filters on — an earlier version of
    // this rule used `createdAt` and would have rejected every anonymous
    // `list` call, including the driver app's own "오늘 등록 목록").
    //
    // `date` is a plain "YYYY-MM-DD" string built from the browser's local
    // clock (see `todayKey()` in both HTML files) — assumed to be Korean
    // devices, so "today" is computed here in Asia/Seoul time to match.
    //
    // Timestamp.year()/.month()/.day() in the rules language take NO
    // arguments and always read UTC — there is no timezone-aware overload
    // (confirmed by the deploy-time compiler warning "Incorrect number of
    // arguments supplied to function: year" when a timezone string was
    // passed here). So Asia/Seoul (UTC+9, no DST) is computed manually by
    // shifting request.time by 9 hours before reading its date parts.
    function isToday(dateStr) {
      let kst = timestamp.value(request.time.toMillis() + 9 * 60 * 60 * 1000);
      return dateStr ==
        string(kst.year()) + '-' +
        (kst.month() < 10 ? '0' : '') + string(kst.month()) + '-' +
        (kst.day() < 10 ? '0' : '') + string(kst.day());
    }

    // Third copy of the 36-store list (see "Store list duplication" in
    // CLAUDE.md — index.html's STORE_DEFS and admin.html's METRO/RURAL are
    // the other two; all three must stay in sync). This one exists purely
    // for write validation: `request.auth != null` alone used to let ANY
    // signed-in client — including the anonymous session index.html grants
    // every visitor on load — write arbitrary values for `store`/`region`
    // into a `deliveries` document. Since both apps interpolate `store`
    // (index.html) into innerHTML unescaped, an attacker who knew that could
    // write an HTML/script payload as `store` directly via the Firestore SDK
    // (bypassing the UI entirely) and get it to execute in every driver's
    // browser for the rest of the day. Pinning `store` to this exact map,
    // and requiring `region` to match its value, closes that off at the one
    // real security boundary this app has (there's no backend server).
    function storeRegion() {
      return {
        "광화문점": "수도권", "이화여대교내서점": "수도권", "인천점": "수도권",
        "일산점": "수도권", "합정점": "수도권", "송도점": "수도권",
        "건대스타시티점": "수도권", "은평점": "수도권", "청량리점": "수도권",
        "동대문점": "수도권", "수유점": "수도권", "강남점": "수도권",
        "서울대교내서점": "수도권", "잠실점": "수도권", "영등포점": "수도권",
        "판교점": "수도권", "목동점": "수도권", "광교점": "수도권",
        "평촌점": "수도권", "천호점": "수도권", "분당점": "수도권",
        "가든파이브점": "수도권", "원그로브점": "수도권", "수원점": "수도권",
        "대구점": "지방", "천안점": "지방", "부산점": "지방", "창원점": "지방",
        "울산점": "지방", "대전점": "지방", "센텀시티점": "지방", "세종점": "지방",
        "전주점": "지방", "경성대부경대점": "지방", "칠곡점": "지방", "광주상무점": "지방"
      };
    }

    match /deliveries/{deliveryId} {
      // 기사 앱(index.html)과 관리자 로그인 상태 모두 create 가능 (기존 동작 유지).
      // 한때 문서 ID를 `${date}_${store}`로 고정해 "하루에 지점당 문서 1개"를
      // 강제한 적이 있었는데, 이건 실제 운영과 안 맞았다 — 수도권 지점은 하루에
      // 2번 이상 배차되는 경우가 실제로 있어서 같은 지점의 두 번째 정상 등록을
      // 규칙이 그대로 막아버렸다. 그래서 원래대로 `.add()`가 만드는 임의 ID로
      // 되돌렸다 (지점당 하루 1건 제한 없음). 대신 문서 ID 자체의 문자 구성을
      // 화이트리스트로 강제해서, `data-complete="${e.id}"`(index.html)처럼 HTML
      // 속성에 그대로 꽂아 넣는 곳이 속성-이탈 XSS에 노출되지 않게 한다 —
      // `.add()`의 자동 ID는 원래도 항상 이 형식이라 정상 흐름에는 영향 없다.
      //
      // 필드 자체도 실제 앱이 만드는 모양 그대로만 허용한다: 정해진 36개 지점 중
      // 하나(+region 일치), 오늘 날짜, startAt/createdAt은 진짜 타임스탬프,
      // endAt은 생성 시 항상 null — 여기서 벗어나는 값(엉뚱한 문자열, 미래/과거
      // 날짜, 임의 필드 추가 등)은 전부 거부한다.
      allow create: if request.auth != null &&
        deliveryId.matches('[A-Za-z0-9_-]+') &&
        request.resource.data.keys().hasOnly(['store', 'region', 'date', 'startAt', 'endAt', 'createdAt']) &&
        request.resource.data.store in storeRegion() &&
        request.resource.data.region == storeRegion()[request.resource.data.store] &&
        isToday(request.resource.data.date) &&
        request.resource.data.startAt is timestamp &&
        request.resource.data.endAt == null &&
        request.resource.data.createdAt is timestamp;

      // update는 "운송완료" 한 가지 동작만 허용한다: 아직 endAt이 없는 문서에
      // endAt(타임스탬프)만 채워 넣는 것. store/region/date/startAt/createdAt은
      // 생성 이후 절대 못 바꾸고, 이미 완료된(endAt이 있는) 문서는 재수정도 못한다
      // — index.html/admin.html 어느 쪽에도 원래 되돌리기(undo) 기능이 없는
      // 설계와 맞물려, 완료 기록을 조용히 덮어쓰는 경로 자체를 막는다.
      allow update: if request.auth != null &&
        resource.data.endAt == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endAt']) &&
        request.resource.data.endAt is timestamp;

      // list(쿼리) 읽기:
      //  - 관리자(ADMIN_EMAIL로 로그인)는 전체 기간 조회 가능 (30일 통계용)
      //  - 그 외 인증된 클라이언트(기사 앱의 익명 세션 포함)는 오늘 날짜(date == 오늘)
      //    문서만 조회 가능 — 두 앱 모두 이미 date 필드로 동등 비교(==) 쿼리만 사용하므로
      //    이 조건과 정확히 맞아떨어짐. 30일치 range(>=) 쿼리는 대부분의 문서에서
      //    isToday()가 거짓이 되어 전체 요청이 거부됨.
      // `request.auth.token.email`은 익명 로그인(기사 앱)에는 존재하지 않는 클레임이라
      // 곧바로 비교하면 Firestore 규칙 평가 자체가 에러로 실패해 전체 allow를 거부한다
      // (`||`가 이 에러를 삼키지 않음) — 그래서 `'email' in ...`로 존재 여부부터 확인한다.
      allow list: if request.auth != null &&
        (
          (('email' in request.auth.token) && request.auth.token.email == "dreamsinblue@gmail.com")
          || isToday(resource.data.date)
        );
    }
  }
}
